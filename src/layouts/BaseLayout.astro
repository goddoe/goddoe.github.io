---
import '../styles/global.css';
import LangToggle from '../components/LangToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const siteTitle = 'Sungju Kim';
const siteDescription =
  'AI Research Engineer. Excited with AI, Code LLM and NLP.';

const { title, description = siteDescription } = Astro.props;
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteTitle}
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // English is the default; only an explicit KO choice is remembered.
      try {
        if (localStorage.getItem('lang') === 'ko') {
          document.documentElement.dataset.lang = 'ko';
          document.documentElement.lang = 'ko';
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <h1 class="site-title"><a href="/">{siteTitle}</a></h1>
        <nav class="site-nav">
          <a href="/">Blog</a>
          <a href="/creative/">Creative</a>
          <a href="/about/">About</a>
          <LangToggle />
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        {siteTitle} · <a href="https://github.com/goddoe">github.com/goddoe</a>
      </div>
    </footer>
  </body>
</html>
